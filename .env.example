# Copy to .env to override defaults used by docker-compose.yml
POSTGRES_PASSWORD=trackwise
JWT_SECRET=change-me-in-real-deployments
MINIO_ROOT_USER=trackwise
MINIO_ROOT_PASSWORD=trackwise-secret
# Alert scanner interval (ms). Short on purpose so the demo reacts quickly.
ALERT_SCAN_INTERVAL_MS=60000
# Browser-visible API URL (baked into the web build)
NEXT_PUBLIC_API_URL=http://localhost:4000
